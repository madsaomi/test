# Токен Telegram-бота (получить в @BotFather)
BOT_TOKEN=your_bot_token_here

# Chat ID получателей через запятую (личные ID или ID групп со знаком минус)
# Пример: CHAT_ID=-1001234567890,123456789
CHAT_ID=

# Токен админ-эндпоинта /admin/results (эндпоинт выключен, если пусто)
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# Путь к базе данных SQLite (по умолчанию results.db)
# DATABASE_PATH=results.db
